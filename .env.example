# Required for admin login (defaults to fernent-dev in local prototype)
ADMIN_PASSWORD=change-me

# Optional canonical site URL for SEO metadata + email alert links
NEXT_PUBLIC_SITE_URL=https://journal-fernent.vercel.app

# Turso / libSQL (optional — without these, content/*.json + memory fallback is used)
# Create a DB at https://turso.tech then:
#   turso db show <name> --url
#   turso db tokens create <name>
TURSO_DATABASE_URL=libsql://your-db-name-your-org.turso.io
TURSO_AUTH_TOKEN=

# Optional: Vercel Blob for image/PDF uploads on read-only FS (Vercel)
# Create a Blob store in the Vercel dashboard and copy the token.
BLOB_READ_WRITE_TOKEN=

# Resend — newsletter alerts when admin publishes a brève / capsule / mensuel
# Get an API key at https://resend.com — without RESEND_API_KEY, alerts are skipped (publish still works).
# Production: verify your domain in Resend and set EMAIL_FROM to that domain (onboarding@resend.dev is for testing only).
RESEND_API_KEY=
EMAIL_FROM=Journal Ferñent <alerts@your-domain.com>

# NVIDIA Build — FLUX.1-schnell (admin IA covers) + Magpie TTS (article listen)
# Get a key at https://build.nvidia.com (NVIDIA API Key / NGC).
# Set the same variable on Vercel → Project → Settings → Environment Variables.
# Do NOT commit the real key.
NVIDIA_API_KEY=
